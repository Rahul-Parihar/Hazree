# App Settings
APP_NAME="Hazree Backend"
ADMIN_EMAIL="admin@hazree.com"
DEBUG=True
SECRET_KEY="your-secret-key-here"

# Server Settings
HOST="0.0.0.0"
PORT=8000
RELOAD=True

# JWT Token Expiration & Authentication Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"
JWT_ISSUER="hazree-auth-server"
JWT_AUDIENCE="hazree-admin-portal"

# Cookie Security Settings (Set COOKIE_SECURE=True in HTTPS Production)
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# Database Settings (PostgreSQL Parameters)
POSTGRES_USER="neondb_owner"
POSTGRES_PASSWORD="your_neon_password"
POSTGRES_SERVER="ep-delicate-field-aumbz9ah-pooler.c-10.us-east-1.aws.neon.tech"
POSTGRES_PORT="5432"
POSTGRES_DB="neondb"

# Main Database URL
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-delicate-field-aumbz9ah-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis Cache Settings
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=True
REDIS_DEFAULT_TTL=300

# Rate Limiting Settings (Brute-Force & DDoS Protection)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT="120/minute"
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REFRESH="10/minute"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173"
CORS_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1)(:\d+)?$"
CORS_FALLBACK_ORIGIN="http://localhost:3000"
